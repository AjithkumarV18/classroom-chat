{
  "info": {
    "name": "Classroom Chat - Notification Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "sessionId", "value": "TEST-ROOM-20260730093349" },
    { "key": "batchId", "value": "TEST-BATCH-20260730093349" }
  ],
  "item": [
    {
      "name": "Demo Login - Admin",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('token', data.access_token);"] } }],
      "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"role\": \"Admin\"\n}" }, "url": "{{baseUrl}}/api/auth/demo-login" }
    },
    {
      "name": "Create Notification",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const data = pm.response.json();", "pm.collectionVariables.set('notificationId', data.notification_id);"] } }],
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"batch_id\": \"{{batchId}}\",\n  \"title\": \"TEST - Live Class Started\",\n  \"message\": \"Your live class has started. Please join the session.\",\n  \"target_audience\": \"Batch\",\n  \"priority\": \"High\"\n}" }, "url": "{{baseUrl}}/api/notifications" }
    },
    {
      "name": "Get All Notifications",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/api/notifications?page=1&page_size=20" }
    },
    {
      "name": "Get My Notifications",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/api/notifications/my?page=1&page_size=20" }
    },
    {
      "name": "Get Notification Details",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/api/notifications/{{notificationId}}" }
    },
    {
      "name": "Mark As Read",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PUT", "url": "{{baseUrl}}/api/notifications/{{notificationId}}/read" }
    },
    {
      "name": "Unread Count",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "GET", "url": "{{baseUrl}}/api/notifications/unread-count" }
    },
    {
      "name": "Mark All As Read",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PATCH", "url": "{{baseUrl}}/api/notifications/read-all" }
    },
    {
      "name": "Update Notification",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "PUT", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"TEST - Live Class Started (Updated)\",\n  \"priority\": \"Emergency\"\n}" }, "url": "{{baseUrl}}/api/notifications/{{notificationId}}" }
    },
    {
      "name": "Soft Delete Notification",
      "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "url": "{{baseUrl}}/api/notifications/{{notificationId}}" }
    }
  ]
}
